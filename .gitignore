# Godot auto generated files
*.gen.*
.godot/

# Ignore library files but not the gdextension file (the addon's bin/ — was project/bin/)
project/addons/opencv_aruco/bin/*
!project/addons/opencv_aruco/bin/android
project/addons/opencv_aruco/bin/android/*
!project/addons/opencv_aruco/bin/android/.gitkeep
!project/addons/opencv_aruco/bin/linux
project/addons/opencv_aruco/bin/linux/*
!project/addons/opencv_aruco/bin/linux/.gitkeep
!project/addons/opencv_aruco/bin/macos
project/addons/opencv_aruco/bin/macos/*
!project/addons/opencv_aruco/bin/macos/.gitkeep
!project/addons/opencv_aruco/bin/windows
project/addons/opencv_aruco/bin/windows/*
!project/addons/opencv_aruco/bin/windows/.gitkeep
!project/addons/opencv_aruco/bin/*.gdextension
!project/addons/opencv_aruco/bin/*.gdextension.uid

# CMake's root bin/ build output (keep the empty platform dirs via .gitkeep)
bin/*
!bin/android
bin/android/*
!bin/android/.gitkeep
!bin/linux
bin/linux/*
!bin/linux/.gitkeep
!bin/macos
bin/macos/*
!bin/macos/.gitkeep
!bin/windows
bin/windows/*
!bin/windows/.gitkeep

# Python bytecode cache
__pycache__/

# Python venv for the tools/ scripts (tcp_receiver, cameraCalibration). Lives at the PROJECT
# ROOT because the scripts use paths relative to it, so they are all run from there.
# Recreate with: py -3 -m venv .venv && ./.venv/Scripts/python.exe -m pip install -r tools/requirements.txt
.venv/

.sconsign*.dblite

# Ignore custom.py
custom.py

# Ignore generated compile_commands.json
compile_commands.json

# Ignore files generated for documentation
/src/gen

# Binaries
*.o
*.os
*.so
# Windows GDExtension builds. The addon's own DLL is already covered by the
# addons/opencv_aruco/bin/windows/* rule above; this catches strays built elsewhere.
*.dll
*.obj
*.bc
*.pyc
*.dblite
*.pdb
*.lib
*.config
*.creator
*.creator.user
*.files
*.includes
*.idb
*.exp

# Godot hot-reload backup copies of loaded GDExtension DLLs (Windows)
~*.dll
~*.TMP

# Godot editor scene/resource save temporaries (<file><random>.tmp, written next to the target and
# renamed over it). Orphaned when a save is interrupted or the rename is blocked.
*.tscn*.tmp
*.tres*.tmp


# Other stuff
*.log
*.lock

# VSCode
.vscode/*
!.vscode/extensions.json
.DS_Store

# Jetbrains
.idea/

# Cmake
cmake-build*
CMakeUserPresets.json

# CMake build output
/build/

# Gradle / Android build output
.gradle/
/project/android/build/

# Android export artifacts
*.apk
*.aab

# Godot export credentials (keystore paths/passwords — per machine, never commit)
project/export_credentials.cfg

# OpenCV (lokaler Build-Input, via Conan verwaltet — nicht eingecheckt)
opencv/

# Conan (von `scons`/`conan install` generiert)
conan_install/
SConscript_conandeps
conandeps*
conanbuild*
conanrun*
deactivate_conan*
conaninfo.txt
conan.lock
graph_info.json
